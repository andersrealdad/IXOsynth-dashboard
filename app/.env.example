# Vantage Pro desk host (src/pages/VantagePro.tsx, route /vantage)
# Base URL of the embeddable desk built by Grok Build. Unset = page shows a "not configured" card.
VITE_VANTAGE_DESK_URL=
# Comma-separated origin allowlist for the vantage:select postMessage bus.
# Defaults to the origin of VITE_VANTAGE_DESK_URL. "*" is honored ONLY in `vite dev`; production ignores it.
VITE_VANTAGE_DESK_ORIGINS=
